{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && !newData.exists() && (data.child('meta/ownerUid').val() === auth.uid || (data.child('players').child(auth.uid).exists() && (!data.child('slots/1').exists() || data.child('slots/1').val() === auth.uid) && (!data.child('slots/2').exists() || data.child('slots/2').val() === auth.uid) && (!data.child('slots/3').exists() || data.child('slots/3').val() === auth.uid) && (!data.child('slots/4').exists() || data.child('slots/4').val() === auth.uid)))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('ownerUid').val() === auth.uid) || (data.exists() && root.child('rooms').child($code).child('players').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['hostUid', 'ownerUid', 'createdAt', 'status'])",
          "hostUid": {
            ".validate": "newData.isString() && (!data.exists() || root.child('rooms').child($code).child('players').child(newData.val()).exists())"
          },
          "ownerUid": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'closed'"
          },
          "version": {
            ".validate": "newData.isNumber()"
          },
          "allowSpending": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "slots": {
          ".read": "auth != null",
          "$n": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta').exists() && ((!data.exists() && newData.val() === auth.uid) || (!newData.exists() && (data.val() === auth.uid || root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid)))",
            ".validate": "newData.isString() && ($n === '1' || $n === '2' || $n === '3' || $n === '4')"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta').exists() && ((auth.uid === $uid && (root.child('rooms').child($code).child('slots/1').val() === auth.uid || root.child('rooms').child($code).child('slots/2').val() === auth.uid || root.child('rooms').child($code).child('slots/3').val() === auth.uid || root.child('rooms').child($code).child('slots/4').val() === auth.uid)) || (data.exists() && newData.exists() && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "station": {
              ".validate": "newData.val() === 'cashier' || newData.val() === 'tea' || newData.val() === 'topping' || newData.val() === 'stock'"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "outfit": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['data', 'seq']) && newData.child('seq').isNumber()"
        },
        "live": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['cupId', 'tea', 'amount']) && newData.child('amount').isNumber() && newData.child('amount').val() >= 0 && newData.child('amount').val() <= 2"
          }
        },
        "actions": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || (!newData.exists() && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'seq', 'action']) && newData.child('seq').isNumber()"
          }
        },
        "emotes": {
          "$id": {
            ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'kind']) && (newData.child('kind').val() === 'heart' || newData.child('kind').val() === 'smile' || newData.child('kind').val() === 'thumb' || newData.child('kind').val() === 'hurry')"
          }
        }
      }
    },
    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['tipCoins', 'updatedAt'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "outfit": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "ownedOutfits": {
          ".validate": "newData.hasChildren()"
        },
        "tipCoins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && (!data.exists() || newData.val() - data.val() <= 2000000)"
        },
        "stats": {
          ".validate": "newData.hasChildren()"
        },
        "excellent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "loginCode": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "shops": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (data.child('room').isString() && root.child('rooms').child(data.child('room').val()).child('meta/hostUid').val() === auth.uid))",
        ".write": "auth != null && newData.exists() && (auth.uid === $uid || (newData.child('room').isString() && root.child('rooms').child(newData.child('room').val()).child('meta/ownerUid').val() === $uid && root.child('rooms').child(newData.child('room').val()).child('meta/hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['ownerUid', 'day', 'cash', 'stock', 'updatedAt'])",
        "ownerUid": {
          ".validate": "newData.val() === $uid"
        },
        "day": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000 && (!data.exists() || newData.val() === 1 || (newData.val() >= data.val() && newData.val() <= data.val() + 7))"
        },
        "cash": {
          ".validate": "newData.isNumber() && newData.val() >= -10000000 && newData.val() <= 1000000000 && (data.exists() ? ((newData.val() - data.val() <= 5000000 && data.val() - newData.val() <= 5000000) || (newData.parent().child('day').val() === 1 && newData.val() <= 500000)) : newData.val() <= 50000000)"
        },
        "stock": {
          ".validate": "newData.hasChildren()",
          "$item": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() - data.val() <= 5000 || newData.parent().parent().child('day').val() === 1)"
          }
        },
        "dayFinished": {
          ".validate": "newData.isBoolean()"
        },
        "seed": {
          ".validate": "newData.isNumber()"
        },
        "ratingSum": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "ratingCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "shopName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "unlockedTeas": {
          ".validate": "newData.hasChildren()"
        },
        "unlockedToppings": {
          ".validate": "newData.hasChildren()"
        },
        "upgrades": {
          ".validate": "newData.hasChildren()"
        },
        "decor": {
          ".validate": "newData.hasChildren()"
        },
        "history": {
          "$day": {
            ".validate": "newData.hasChildren(['day'])"
          }
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
